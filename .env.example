# 로컬 CSV 원본 경로
CSV_PATH=

# Kafka 브로커 주소
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# raw zone 저장 위치
S3_BUCKET=
AWS_REGION=ap-northeast-2

# Flink S3A 컨테이너 인증용
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Superset 세션 서명 키. python3 -c "import secrets;print(secrets.token_urlsafe(42))" 로 생성
SUPERSET_SECRET_KEY=

# Superset 메타데이터용 PostgreSQL
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Superset 공유 캐시
REDIS_URL=redis://redis:6379/0

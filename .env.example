# 로컬 CSV 원본 경로
CSV_PATH=

# Kafka 브로커 주소
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# raw zone 저장 위치
S3_BUCKET=
AWS_REGION=ap-northeast-2

# Spark 드라이버 힙. 미설정 시 8g (code/pipelines/spark_session.py 기본값)
SPARK_DRIVER_MEMORY=8g

# Flink S3A 컨테이너 인증용
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Superset 세션 서명 키. python3 -c "import secrets;print(secrets.token_urlsafe(42))" 로 생성
SUPERSET_SECRET_KEY=

# Superset 메타데이터용 PostgreSQL
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Superset 공유 캐시
REDIS_URL=redis://redis:6379/0

# Airflow 전용 메타DB·암호화 키·로컬 관리자. Superset PostgreSQL/Redis와 공유하지 않는다.
AIRFLOW_POSTGRES_PASSWORD=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=
